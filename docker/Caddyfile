# Serves the static build inside the container. HTTPS, the domain and security headers are handled by
# the Caddy in front of it (infra repo); this one only listens on plain HTTP inside the Docker network.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Fingerprinted assets (file names change on every build) can be cached forever.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Read by the deploy pipeline and the healthcheck: must always be fresh.
	@version path /version.json
	header @version Cache-Control "no-store"

	file_server
}
