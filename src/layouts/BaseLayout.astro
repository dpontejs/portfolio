---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { initTheme } from "../lib/theme";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Diego Ponte — Machine Learning Engineer",
  description = "Machine Learning Engineer working on AI engineering, computer vision, deep learning, RAG and LLMs.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Inline, blocking on purpose: sets the theme before the first paint (no flash of the wrong theme).
const themeScript = `(${initTheme.toString()})()`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#306998" />
    <script is:inline set:html={themeScript} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-12 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
