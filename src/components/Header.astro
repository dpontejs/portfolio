---
import type { Locale } from "../i18n/config";
import { localizePath, useTranslations } from "../i18n/utils";
import LanguageSwitch from "./LanguageSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sections = [
  { id: "about", label: t("nav.about") },
  { id: "projects", label: t("nav.projects") },
  { id: "experience", label: t("nav.experience") },
  { id: "skills", label: t("nav.skills") },
  { id: "education", label: t("nav.education") },
];
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={localizePath("/", locale)} class="font-mono text-lg font-semibold tracking-tight">
      <span class="text-accent">diego</span>
      <span class="text-muted">ponte</span>
      <span class="text-highlight-fg">.dev</span>
    </a>
    <nav class="hidden gap-5 text-sm text-muted lg:flex">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="hover:text-fg">
          {s.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <LanguageSwitch locale={locale} />
      <ThemeToggle label={t("a11y.themeToggle")} />
    </div>
  </div>
</header>
