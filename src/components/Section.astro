---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-8 space-y-6">
  <h2 id={`${id}-title`} class="flex items-center gap-3 text-2xl font-bold tracking-tight">
    <span class="h-6 w-1 rounded bg-highlight" aria-hidden="true"></span>
    {title}
  </h2>
  <slot />
</section>
