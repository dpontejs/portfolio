---
import { profile } from "../data/profile";
import type { Locale } from "../i18n/config";
import { formatPeriod, useTranslations } from "../i18n/utils";
import Section from "./Section.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = profile[locale];
---

<div class="space-y-20">
  <section class="space-y-6">
    <p class="font-mono text-sm text-accent">{t("hero.greeting")}</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{p.name}</h1>
    <p class="text-xl text-muted">{p.headline}</p>
    <div class="h-1 w-16 rounded bg-highlight" aria-hidden="true"></div>
    <p class="max-w-prose text-lg leading-relaxed">{p.intro}</p>
    <div class="flex flex-wrap gap-3">
      {p.links.map((link, i) => (
        <a
          href={link.href}
          class:list={[
            "rounded-md px-4 py-2 font-medium transition",
            i === 0
              ? "bg-accent text-accent-fg hover:opacity-90"
              : "border border-border hover:bg-surface",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <Section id="about" title={t("nav.about")}>
    <div class="max-w-prose space-y-4 leading-relaxed">
      {p.summary.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </Section>

  <Section id="experience" title={t("nav.experience")}>
    <ol class="space-y-10 border-l-2 border-border pl-6">
      {p.experience.map((role) => (
        <li class="relative">
          <span
            class="absolute top-1.5 -left-[31px] size-3 rounded-full border-2 border-accent bg-bg"
            aria-hidden="true"
          />
          <h3 class="text-lg font-semibold">{role.title}</h3>
          <p class="text-accent">{role.company}</p>
          <p class="mt-1 font-mono text-sm text-muted">
            <time datetime={role.start}>{formatPeriod(role.start, role.end, locale)}</time> ·{" "}
            {role.location}
          </p>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 leading-relaxed marker:text-muted">
            {role.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="skills" title={t("nav.skills")}>
    <div class="space-y-6">
      {p.skills.map((group) => (
        <div class="space-y-3">
          <h3 class="font-mono text-sm text-muted">{t(group.labelKey)}</h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-md border border-border bg-surface px-3 py-1 text-sm">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section id="education" title={t("nav.education")}>
    <ul class="space-y-4">
      {p.education.map((e) => (
        <li>
          <h3 class="font-semibold">{e.title}</h3>
          <p class="text-muted">
            {e.institution} · <span class="font-mono text-sm">{e.period}</span>
          </p>
        </li>
      ))}
    </ul>
  </Section>
</div>
